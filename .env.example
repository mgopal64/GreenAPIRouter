# Copy to .env and fill in locally. Never commit .env or put real keys in this file.
# Set to dev ONLY on your laptop (turns on /docs). Leave empty in production.
GREENROUTER_ENV=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Azure OpenAI deployments (one resource per region). Keys are secrets: no quotes or <> brackets.
WESTUS_ENDPOINT=
WESTUS_KEY=
NCUS_ENDPOINT=
NCUS_KEY=
SMALL_DEPLOYMENT=gpt-4.1-mini
LARGE_DEPLOYMENT=gpt-5-mini

# Password the app sends in the X-Demo-Token header to make live calls. Must be 20+ chars or /complete stays disabled.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_TOKEN=
MAX_LIVE_CALLS_PER_DAY=200

# Set to 1 when deployed behind one reverse proxy (Render, Railway, Fly). Keep 0 locally.
TRUSTED_PROXY_HOPS=0

# EIA grid data (jobs/eia_ingest.py). Server-side only.
EIA_API_KEY=

# TigerData (Timescale) connection string. Contains a password: server-side only, never commit.
TIGER_DSN=

# Set to 1 in production after the build step downloads the picker model, so it never downloads at runtime.
HF_HUB_OFFLINE=0
